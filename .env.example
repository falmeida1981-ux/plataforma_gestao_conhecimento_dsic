# Copiar para .env (nunca versionar o .env). Valores abaixo são os do ambiente de desenvolvimento local,
# criados por scripts/dev/criar-bd-dev.sql. Em produção ver deploy/.env.producao.example.

# Utilizador da aplicação e do worker: só DML (SELECT, INSERT, UPDATE, DELETE).
DATABASE_URL="mysql://dsic_app:dsic_app_dev@127.0.0.1:3307/dsic_ops_dev"
# Utilizador dono do esquema: usado apenas pelo CLI do Prisma (migrate).
DATABASE_URL_MIGRACOES="mysql://dsic_migracoes:dsic_migracoes_dev@127.0.0.1:3307/dsic_ops_dev"
# Base de dados fixa para o shadow database do `prisma migrate dev`.
DATABASE_URL_SHADOW="mysql://dsic_migracoes:dsic_migracoes_dev@127.0.0.1:3307/dsic_ops_shadow"
# Máximo de ligações do pool e TLS até ao MySQL (true em produção se o MySQL estiver noutra máquina).
DB_LIGACOES_MAX=10
DB_SSL=false

# Endereço pelo qual os utilizadores acedem, ex.: http://10.0.0.5:3002 (opcional até ao M6: links nas notificações).
APP_URL="http://localhost:3000"

# Pasta dos anexos, fora da pasta pública (RNF06).
PASTA_ANEXOS="./dados/anexos"

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Chave AES-256-GCM (32 bytes em base64) para cifrar segredos na BD (RNF04). Obrigatória a partir do M2.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CIFRA=

# Rede com inspeção TLS (proxy da CMG): o Node passa a confiar nos certificados do Windows.
# NODE_OPTIONS=--use-system-ca

# Porta da aplicação (o IIS encaminha para http://127.0.0.1:PORT).
PORT=3000

# Cópias de segurança feitas pelo deploy (scripts/backup-bd.mjs). Idealmente noutro disco.
BACKUP_PASTA="./backups"
# Número de cópias a manter (0 = nunca remover).
BACKUP_RETENCAO=30
# Caminho do mysqldump, se não for encontrado automaticamente em C:\Program Files\MySQL.
# MYSQLDUMP="C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe"

# Node próprio desta plataforma (servidor com outras aplicações noutro Node): pasta criada por
# deploy\instalar-node.ps1. Usado pelo deploy.cmd e pelos serviços Windows. Vazio = Node do sistema.
# NODE_HOME=C:\nodejs24
