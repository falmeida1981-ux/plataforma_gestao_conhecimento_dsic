# Copiar para deploy/.env no servidor e preencher. Nunca versionar o ficheiro preenchido.
# As palavras-passe entram em URLs de ligação: usar só letras, números, "-" e "_".

APP_URL=https://dsic-ops.exemplo.local
LOG_LEVEL=info

MYSQL_DATABASE=dsic_ops
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
MYSQL_MIGRACOES_PASSWORD=

# Chave AES-256-GCM (32 bytes em base64). Guardar também fora do servidor: sem ela os segredos em BD perdem-se.
CHAVE_CIFRA=
